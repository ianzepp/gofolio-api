[
  {
    "name": "account-balance-post-no-auth-unauthorized",
    "method": "POST",
    "path": "/api/v1/account-balance",
    "mode": "status",
    "requiredEnv": ["ADMIN_USER_ID"],
    "body": {
      "accountId": "${ADMIN_USER_ID}",
      "balance": 1,
      "date": "2024-01-01"
    }
  },
  {
    "name": "account-balance-delete-no-auth-unauthorized",
    "method": "DELETE",
    "path": "/api/v1/account-balance/${ADMIN_USER_ID}",
    "mode": "status",
    "requiredEnv": ["ADMIN_USER_ID"]
  },
  {
    "name": "account-balance-post-foreign-account-forbidden-parity",
    "method": "POST",
    "path": "/api/v1/account-balance",
    "mode": "status",
    "auth": "jwt:JWT_EMPTY_USER_TOKEN",
    "requiredEnv": ["JWT_EMPTY_USER_TOKEN", "TRANSFER_ACCOUNT_FROM_ID"],
    "body": {
      "accountId": "${TRANSFER_ACCOUNT_FROM_ID}",
      "balance": 1,
      "date": "2024-01-01"
    }
  },
  {
    "name": "account-balance-delete-foreign-id-forbidden-parity",
    "method": "DELETE",
    "path": "/api/v1/account-balance/${ADMIN_USER_ID}",
    "mode": "status",
    "auth": "jwt:JWT_USER_TOKEN",
    "requiredEnv": ["JWT_USER_TOKEN", "ADMIN_USER_ID"]
  },
  {
    "name": "account-balance-post-user-created-parity",
    "method": "POST",
    "path": "/api/v1/account-balance",
    "mode": "status",
    "auth": "jwt:JWT_USER_TOKEN",
    "requiredEnv": ["JWT_USER_TOKEN", "TRANSFER_ACCOUNT_FROM_ID"],
    "body": {
      "accountId": "${TRANSFER_ACCOUNT_FROM_ID}",
      "balance": 101,
      "date": "2024-01-05"
    }
  }
]
