[
  {
    "name": "health-basic-status",
    "method": "GET",
    "path": "/api/v1/health",
    "mode": "status"
  },
  {
    "name": "health-data-enhancer-status",
    "method": "GET",
    "path": "/api/v1/health/data-enhancer/yahoo-finance",
    "mode": "status"
  },
  {
    "name": "health-data-provider-status",
    "method": "GET",
    "path": "/api/v1/health/data-provider/YAHOO",
    "mode": "status"
  },
  {
    "name": "info-status",
    "method": "GET",
    "path": "/api/v1/info",
    "mode": "status"
  },
  {
    "name": "tags-get-no-auth-unauthorized",
    "method": "GET",
    "path": "/api/v1/tags",
    "mode": "status"
  },
  {
    "name": "tags-get-invalid-bearer-unauthorized",
    "method": "GET",
    "path": "/api/v1/tags",
    "mode": "status",
    "headers": {
      "Authorization": "Bearer invalid.token.value"
    }
  },
  {
    "name": "tags-get-api-key-user-parity",
    "method": "GET",
    "path": "/api/v1/tags",
    "mode": "status",
    "auth": "api-key:API_KEY_USER",
    "requiredEnv": ["API_KEY_USER"]
  },
  {
    "name": "tags-post-user-missing-user-id-parity",
    "method": "POST",
    "path": "/api/v1/tags",
    "mode": "status",
    "auth": "jwt:JWT_USER_TOKEN",
    "requiredEnv": ["JWT_USER_TOKEN"],
    "body": {
      "name": "integration-tag-user-missing-id"
    }
  },
  {
    "name": "tags-post-user-foreign-user-id-parity",
    "method": "POST",
    "path": "/api/v1/tags",
    "mode": "status",
    "auth": "jwt:JWT_USER_TOKEN",
    "requiredEnv": ["JWT_USER_TOKEN", "ADMIN_USER_ID"],
    "body": {
      "name": "integration-tag-user-foreign-id",
      "userId": "${ADMIN_USER_ID}"
    }
  },
  {
    "name": "tags-post-demo-forbidden-parity",
    "method": "POST",
    "path": "/api/v1/tags",
    "mode": "status",
    "auth": "jwt:JWT_DEMO_TOKEN",
    "requiredEnv": ["JWT_DEMO_TOKEN", "DEMO_USER_ID"],
    "body": {
      "name": "integration-tag-demo",
      "userId": "${DEMO_USER_ID}"
    }
  },
  {
    "name": "user-access-token-wrong-token-forbidden-parity",
    "method": "POST",
    "path": "/api/v1/user/access-token",
    "mode": "status",
    "auth": "jwt:JWT_USER_TOKEN",
    "requiredEnv": ["JWT_USER_TOKEN"],
    "body": {
      "accessToken": "integration-invalid-access-token"
    }
  },
  {
    "name": "order-delete-empty-user-json-parity",
    "method": "DELETE",
    "path": "/api/v1/order",
    "mode": "json",
    "auth": "jwt:JWT_EMPTY_USER_TOKEN",
    "requiredEnv": ["JWT_EMPTY_USER_TOKEN"]
  },
  {
    "name": "user-delete-own-wrong-token-forbidden-parity",
    "method": "DELETE",
    "path": "/api/v1/user",
    "mode": "status",
    "auth": "jwt:JWT_EMPTY_USER_TOKEN",
    "requiredEnv": ["JWT_EMPTY_USER_TOKEN"],
    "body": {
      "accessToken": "integration-invalid-access-token"
    }
  }
]
