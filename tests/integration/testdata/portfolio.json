  {
    "name": "roai-holdings-json",
    "method": "GET",
    "path": "/api/v1/portfolio/holdings",
    "mode": "json",
    "auth": "jwt:JWT_ROAI_TOKEN",
    "requiredEnv": ["JWT_ROAI_TOKEN", "ROAI_SEEDED"],
    "ignoreJsonPaths": [
      "holdings.*.id",
      "holdings.*.dateOfFirstActivity",
      "holdings.*.marketChange",
      "holdings.*.marketChangePercent",
      "holdings.*.marketPrice",
      "holdings.*.marketPriceInBaseCurrency",
      "holdings.*.netPerformance",
      "holdings.*.netPerformancePercent",
      "holdings.*.netPerformancePercentWithCurrencyEffect",
      "holdings.*.netPerformanceWithCurrencyEffect",
      "holdings.*.grossPerformance",
      "holdings.*.grossPerformancePercent",
      "holdings.*.grossPerformancePercentWithCurrencyEffect",
      "holdings.*.grossPerformanceWithCurrencyEffect",
      "holdings.*.valueInBaseCurrency",
      "holdings.*.valueInPercentage",
      "holdings.*.allocationInPercentage",
      "holdings.*.investment",
      "holdings.*.dividend"
    ]
  },
