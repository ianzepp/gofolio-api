[
  {
    "name": "export-no-auth-unauthorized",
    "method": "GET",
    "path": "/api/v1/export",
    "mode": "status"
  },
  {
    "name": "export-no-auth-unauthorized-json-parity",
    "method": "GET",
    "path": "/api/v1/export",
    "mode": "json"
  },
  {
    "name": "export-user-ok-parity",
    "method": "GET",
    "path": "/api/v1/export",
    "mode": "status",
    "auth": "jwt:JWT_USER_TOKEN",
    "requiredEnv": ["JWT_USER_TOKEN"]
  },
  {
    "name": "export-user-filtered-account-json-parity",
    "method": "GET",
    "path": "/api/v1/export?accounts=${TRANSFER_ACCOUNT_FROM_ID}",
    "mode": "json",
    "auth": "jwt:JWT_USER_TOKEN",
    "requiredEnv": ["JWT_USER_TOKEN", "TRANSFER_ACCOUNT_FROM_ID"],
    "ignoreJsonPaths": [
      "meta.date",
      "meta.version",
      "assetProfiles",
      "platforms",
      "tags",
      "user",
      "accounts.*.balances",
      "activities.*.date",
      "activities.*.id",
      "activities.*.tags"
    ]
  },
